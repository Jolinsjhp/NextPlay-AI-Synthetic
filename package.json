{
  "name": "nextplay-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 server.py",
    "start": "python3 server.py",
    "test": "node --test tests/*.test.js && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "analyze": "python3 analysis_agent.py",
    "test:contract": "node scripts/validate_decision_analysis.mjs && node scripts/validate_video_review.mjs",
    "validate:schema": "node scripts/validate_contracts.mjs --dataset data/league",
    "test:decision-analysis": "python3 -m unittest discover -s tests -p \"test_bound_agents.py\"",
    "validate:decision-analysis": "node scripts/validate_decision_analysis.mjs",
    "validate:decision-dataset": "node scripts/validate_decision_dataset.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
