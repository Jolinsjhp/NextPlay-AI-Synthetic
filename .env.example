# Copy values into your shell or cloud secret settings; server does not load .env automatically.
NEXTPLAY_MODEL_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
NEXTPLAY_MODEL=YOUR-DEPLOYMENT-NAME
NEXTPLAY_MODEL_API_KEY=
NEXTPLAY_MODEL_AUTH=auto
# Actual outbound Responses requests, including retries and failed calls. Zero disables model calls.
NEXTPLAY_DAILY_MODEL_CALLS=100
TOUCHLINE_PORT=5173
TOUCHLINE_HOST=127.0.0.1
# For a single-instance HTTPS reverse-proxy deployment only:
# TOUCHLINE_HOST=0.0.0.0
# NEXTPLAY_PUBLIC_ORIGIN=https://your-demo.example
# Persistent private storage, useful on App Service; defaults to repository .local locally.
# NEXTPLAY_STATE_DIR=/home/nextplay
NEXTPLAY_VIDEO_STORAGE_MB=512
# Keep disabled on unauthenticated public judging sites.
NEXTPLAY_VIDEO_UPLOADS=0
