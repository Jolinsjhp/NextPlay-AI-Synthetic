{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nextplay:video-review:1",
  "title": "Manual video observations; separate from synthetic contract-1",
  "$ref": "#/$defs/annotation",
  "$defs": {
    "frame": {
      "type": "object",
      "properties": {
        "video_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 119999
        },
        "period": {
          "enum": [
            1,
            2
          ]
        },
        "period_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599999
        },
        "score": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "minItems": 2,
          "maxItems": 2
        },
        "home_attacks": {
          "enum": [
            "positive_x",
            "negative_x"
          ]
        },
        "actor_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[HA](0[1-9]|10|11)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ball": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "players": {
          "type": "array",
          "maxItems": 22,
          "items": {
            "type": "object",
            "properties": {
              "player_id": {
                "type": "string",
                "pattern": "^[HA](0[1-9]|10|11)$"
              },
              "image": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "player_id",
              "image"
            ],
            "additionalProperties": false
          }
        },
        "landmarks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "image": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "pitch": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 105
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 68
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "image",
              "pitch"
            ],
            "additionalProperties": false
          }
        },
        "confirmed": {
          "type": "object",
          "properties": {
            "calibration_reviewed": {
              "type": "boolean"
            },
            "identities_reviewed": {
              "type": "boolean"
            },
            "positions_reviewed": {
              "type": "boolean"
            },
            "coverage_complete": {
              "type": "boolean"
            },
            "ball_on_ground": {
              "type": "boolean"
            },
            "in_play": {
              "type": "boolean"
            }
          },
          "required": [
            "calibration_reviewed",
            "identities_reviewed",
            "positions_reviewed",
            "coverage_complete",
            "ball_on_ground",
            "in_play"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "video_ms",
        "period",
        "period_ms",
        "score",
        "home_attacks",
        "actor_id",
        "ball",
        "players",
        "landmarks",
        "confirmed"
      ],
      "additionalProperties": false
    },
    "roster_player": {
      "type": "object",
      "properties": {
        "player_id": {
          "type": "string",
          "pattern": "^[HA](0[1-9]|10|11)$"
        },
        "team_id": {
          "enum": [
            "HOME",
            "AWAY"
          ]
        },
        "jersey_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "position": {
          "enum": [
            "GK",
            "OUTFIELD"
          ]
        }
      },
      "required": [
        "player_id",
        "team_id",
        "jersey_number",
        "name",
        "position"
      ],
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "properties": {
        "video_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "video_duration_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "roster": {
          "type": "array",
          "minItems": 4,
          "maxItems": 22,
          "items": {
            "$ref": "#/$defs/roster_player"
          }
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "rights_confirmed": {
          "const": true
        }
      },
      "required": [
        "video_id",
        "video_duration_ms",
        "roster",
        "frames",
        "rights_confirmed"
      ],
      "additionalProperties": false
    }
  }
}
